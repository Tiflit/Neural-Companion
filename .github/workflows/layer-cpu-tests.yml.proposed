# INACTIVE PROPOSAL: copy to layer-cpu-tests.yml only after profile approval.
name: Layer dispatch CPU tests
on:
  pull_request:
    paths:
      - 'src/layer/**'
      - 'tests/cpu/**'
      - '.github/workflows/layer-cpu-tests.yml'
  push:
    branches: [main]
    paths:
      - 'src/layer/**'
      - 'tests/cpu/**'
      - '.github/workflows/layer-cpu-tests.yml'
permissions:
  contents: read
jobs:
  windows-layer-cpu:
    runs-on: windows-2022
    timeout-minutes: 5
    steps:
      - uses: actions/checkout@11bd71901bbe5b1630ceea73d27597364c9af683 # v4.2.2
        with:
          persist-credentials: false
      - name: Read reviewed official build-time headers
        uses: actions/checkout@11bd71901bbe5b1630ceea73d27597364c9af683 # v4.2.2
        with:
          repository: KhronosGroup/Vulkan-Headers
          ref: 6802bb4733b63ed5efd3adb308a6c885ef180ea1
          path: .ci/vulkan-headers
          persist-credentials: false
      - name: Configure real-layer mock CPU fixture
        shell: pwsh
        run: cmake -S tests/cpu -B build/cpu -A x64 "-DNC_VULKAN_HEADERS=$env:GITHUB_WORKSPACE/.ci/vulkan-headers"
      - name: Compile project layer and mock test
        shell: pwsh
        run: cmake --build build/cpu --config Debug --parallel 1
      - name: Run synthetic dispatch cases
        shell: pwsh
        run: ctest --test-dir build/cpu -C Debug --parallel 1 --output-on-failure
