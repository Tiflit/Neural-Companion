# INACTIVE PROPOSAL: this extension is not a GitHub Actions workflow.
# Copy to diagnostic-path-tests.yml only after the human approves the profile.
name: Diagnostic path CPU tests

on:
  pull_request:
    paths:
      - 'src/layer/diagnostic_path.h'
      - 'src/layer/layer.cpp'
      - 'tests/diagnostics/**'
      - '.github/workflows/diagnostic-path-tests.yml'
  push:
    branches: [main]
    paths:
      - 'src/layer/diagnostic_path.h'
      - 'src/layer/layer.cpp'
      - 'tests/diagnostics/**'
      - '.github/workflows/diagnostic-path-tests.yml'

permissions:
  contents: read

jobs:
  windows-cpu:
    runs-on: windows-2022
    timeout-minutes: 5
    steps:
      - uses: actions/checkout@11bd71901bbe5b1630ceea73d27597364c9af683 # v4.2.2
        with:
          persist-credentials: false
      - name: Configure CPU-only tests
        shell: pwsh
        run: cmake -S tests/diagnostics -B build/diagnostics -A x64
      - name: Build CPU-only tests
        shell: pwsh
        run: cmake --build build/diagnostics --config Debug --parallel 1
      - name: Test environment path boundaries
        shell: pwsh
        run: ctest --test-dir build/diagnostics -C Debug --parallel 1 --output-on-failure
